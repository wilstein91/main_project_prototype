# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사해 값을 채운다.
# .env.local 은 절대 커밋하지 않는다 (.gitignore 확인).
# ─────────────────────────────────────────────────────────────

# 배포 주소. Supabase Site URL / Redirect URL 허용 목록과 일치시킬 것.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — 공개 키만 클라이언트에 노출된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# service_role 키는 이 프로젝트에서 사용하지 않는다.
#
# 모든 데이터 접근은 사용자 JWT 를 통과시켜 RLS 판정을 받는다
# (TECH_SPEC §2.1). service_role 키 하나로 접근 제어가 통째로
# 우회되므로, 편의상 쓰기 시작하면 RLS 가 무력화된다.
#
# 키가 한 번이라도 커밋·공유·로그 출력되었다면 즉시 재발급할 것.
# ─────────────────────────────────────────────────────────────
