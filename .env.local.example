# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사해 값을 채운다.
#   cp .env.local.example .env.local
#
# .env.local 은 커밋되지 않는다 (.gitignore 의 .env* 규칙).
# 값을 채운 뒤에는 개발 서버를 재시작해야 반영된다.
#
# 값을 어디서 가져오는지는 SUPABASE_SETUP.md §3 참고.
# ─────────────────────────────────────────────────────────────

# 이 앱이 서비스되는 주소. 인증 메일 링크가 여기로 돌아온다.
# Supabase 의 Site URL / Redirect URLs 와 정확히 일치시킬 것.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Supabase 프로젝트 URL
# 위치: Project Settings → Data API → Project URL
# 형태: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키 (publishable)
# 위치: Project Settings → API Keys → "Publishable and secret API keys" 탭
# 형태: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 예전 프로젝트에서 legacy anon 키를 쓰는 경우에만 아래를 대신 채운다.
# anon 키는 2026년 말 폐기 예정이므로 신규 프로젝트는 위의 publishable 을 쓴다.
# 위치: Project Settings → API Keys → "Legacy API keys" 탭
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# secret 키 (sb_secret_... / 구 service_role) 는 이 프로젝트에서
# 사용하지 않는다. 따라서 이 파일에 넣을 자리도 없다.
#
# 모든 데이터 접근은 사용자 JWT 를 통과시켜 RLS 판정을 받는다
# (TECH_SPEC §2.1). secret 키 하나로 접근 제어가 통째로 우회되므로,
# 편의상 쓰기 시작하면 RLS 가 무력화된다.
#
# 키가 한 번이라도 커밋·공유·로그 출력되었다면 즉시 재발급할 것.
# ─────────────────────────────────────────────────────────────
